generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // set explicitly, otherwise inferred from tsconfig.json (not there yet during npm ci in Docker)
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          Int          @id @default(autoincrement())
  name        String
  title       String
  description String
  links       Link[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model Link {
  id        Int     @id @default(autoincrement())
  label     String
  url       String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        Int     @id @default(autoincrement())
  name      String
  category  String
  profileId Int
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id           Int       @id @default(autoincrement())
  company      String
  position     String
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  achievements String[]
  profileId    Int
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  url         String
  profileId   Int
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
